# Character Creation Devkit - Development Production Environment
# Mirrors production configuration but optimized for local development

# ===== CORE APPLICATION =====
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true

# ===== DATABASE CONFIGURATION =====
DATABASE_URL=postgresql://dreamcast:dreamcast123@db-primary:5432/dreamcast_dev
DB_HOST=db-primary
DB_PORT=5432
DB_NAME=dreamcast_dev
DB_USER=dreamcast
DB_PASSWORD=dreamcast123
DB_POOL_SIZE=20

# Read replica for testing
DB_REPLICA_URL=postgresql://dreamcast:dreamcast123@db-replica:5432/dreamcast_dev

# ===== REDIS CONFIGURATION =====
REDIS_URL=redis://redis-cluster:6379
REDIS_HOST=redis-cluster
REDIS_PORT=6379
REDIS_DB=0

# ===== CELERY CONFIGURATION =====
CELERY_BROKER_URL=redis://redis-cluster:6379/0
CELERY_RESULT_BACKEND=redis://redis-cluster:6379/1

# ===== SECURITY =====
JWT_SECRET_KEY=dev-secret-key-change-in-production-12345678901234567890
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== API CONFIGURATION =====
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:3001", "http://localhost:3002", "http://localhost:8080"]

# ===== FRONTEND CONFIGURATION =====
REACT_APP_API_URL=http://localhost/api
REACT_APP_WS_URL=ws://localhost/ws
REACT_APP_MONITORING_URL=ws://localhost/monitoring
FAST_REFRESH=true

# ===== MONITORING =====
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
ELASTICSEARCH_URL=http://elasticsearch:9200
KIBANA_URL=http://kibana:5601

# Monitoring intervals (seconds)
METRICS_COLLECTION_INTERVAL=30
HEALTH_CHECK_INTERVAL=10
ALERT_CHECK_INTERVAL=60

# ===== LOGGING =====
LOG_LEVEL=DEBUG
LOG_FORMAT=json
ELASTICSEARCH_INDEX=dreamcast-dev

# ===== MODEL CONFIGURATION =====
MODEL_CACHE_DIR=/app/models
HUGGINGFACE_CACHE_DIR=/app/cache/huggingface
MAX_MODEL_MEMORY=4GB

# ===== VOICE & AUDIO =====
TTS_MODEL=kokoro
VOICE_CACHE_SIZE=1000
AUDIO_SAMPLE_RATE=22050
AUDIO_CHANNELS=1

# ===== RATE LIMITING (relaxed for development) =====
RATE_LIMIT_API=200/minute
RATE_LIMIT_WEBSOCKET=100/minute
RATE_LIMIT_CHAT=500/minute

# ===== DEPLOYMENT =====
DEPLOYMENT_STRATEGY=rolling_update
HEALTH_CHECK_TIMEOUT=30
ROLLBACK_ON_FAILURE=true

# ===== A/B TESTING =====
AB_TESTING_ENABLED=true
DEFAULT_EXPERIMENT_DURATION=7
STATISTICAL_SIGNIFICANCE_THRESHOLD=0.95

# ===== DEVELOPMENT SPECIFIC =====
# Debug ports
DEBUG_PORT_API_1=5678
DEBUG_PORT_API_2=5679
DEBUG_PORT_INFERENCE=5680

# Enable hot reloading
ENABLE_HOT_RELOAD=true
ENABLE_SOURCE_MAPS=true

# Development flags
ENABLE_PROFILING=true
ENABLE_REQUEST_LOGGING=true
ENABLE_SQL_LOGGING=false

# Resource limits (relaxed for development)
MAX_WORKER_CONNECTIONS=100
MAX_ASYNC_WORKERS=4
DATABASE_POOL_SIZE=10
REDIS_CONNECTION_POOL_SIZE=10

# ===== THIRD PARTY SERVICES =====
# Mock external services for development
MOCK_EXTERNAL_APIS=true
MOCK_EMAIL_SERVICE=true
MOCK_SMS_SERVICE=true

# ===== BACKUP & RECOVERY =====
BACKUP_ENABLED=false
BACKUP_INTERVAL=daily
BACKUP_RETENTION_DAYS=7

# ===== PERFORMANCE =====
ENABLE_CACHING=true
CACHE_TTL=300
ENABLE_COMPRESSION=true
ENABLE_CDN=false

# ===== FEATURE FLAGS =====
FEATURE_MULTI_CHARACTER=true
FEATURE_VOICE_SYNTHESIS=true
FEATURE_SPATIAL_AUDIO=true
FEATURE_DIRECTORS_CHAIR=true
FEATURE_AB_TESTING=true
FEATURE_REAL_TIME_MONITORING=true

# ===== DOCKER CONFIGURATION =====
COMPOSE_PROJECT_NAME=dreamcast-dev-prod
COMPOSE_FILE=docker-compose.dev-prod.yml

# Image tags
IMAGE_TAG=dev-latest
PLATFORM_API_IMAGE=dreamcast-platform-api:dev-latest
PLATFORM_CLIENT_IMAGE=dreamcast-platform-client:dev-latest
INFERENCE_ENGINE_IMAGE=dreamcast-inference-engine:dev-latest 