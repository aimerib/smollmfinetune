# Dreamcast Platform Production Environment Configuration Template
# Copy this file to .env.production and fill in the values

# Image and Deployment Settings
IMAGE_TAG=v1.0.0
ENVIRONMENT=production

# Domain Configuration
DOMAIN=dreamcast.dev
API_DOMAIN=api.dreamcast.dev
MONITORING_DOMAIN=monitoring.dreamcast.dev

# Database Configuration
DB_NAME=dreamcast_platform
DB_USER=dreamcast_user
DB_PASSWORD=CHANGE_ME_SECURE_DB_PASSWORD
DB_HOST=db-primary
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis-cluster:6379
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD

# JWT and Security
JWT_SECRET_KEY=CHANGE_ME_SECURE_JWT_SECRET_KEY_32_CHARACTERS_OR_MORE
JWT_ALGORITHM=RS256
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800

# SSL/TLS Configuration
ACME_EMAIL=admin@dreamcast.dev
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Application Configuration
LOG_LEVEL=INFO
DEBUG=false
TESTING=false
MONITORING_ENABLED=true
WEBSOCKET_ENABLED=true

# Celery Configuration
CELERY_BROKER_URL=redis://redis-cluster:6379/0
CELERY_RESULT_BACKEND=redis://redis-cluster:6379/0
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=3600
CELERY_TASK_HARD_TIME_LIMIT=7200

# AI/ML Configuration
MODEL_CACHE_SIZE=4G
INFERENCE_TIMEOUT=30
BATCH_SIZE=8
GPU_ENABLED=false
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=4096

# Resource Limits
MAX_UPLOAD_SIZE=100MB
MAX_CONCURRENT_USERS=1000
RATE_LIMIT_PER_MINUTE=1000
WEBSOCKET_MAX_CONNECTIONS=500

# Monitoring and Metrics
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_SECURE_GRAFANA_PASSWORD
ELASTICSEARCH_HEAP_SIZE=2g

# Email Configuration (for notifications)
SMTP_HOST=smtp.dreamcast.dev
SMTP_PORT=587
SMTP_USER=notifications@dreamcast.dev
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_USE_TLS=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=dreamcast-backups
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_REGION=us-east-1

# Performance and Scaling
AUTO_SCALING_ENABLED=true
SCALE_UP_CPU_THRESHOLD=80
SCALE_DOWN_CPU_THRESHOLD=30
MIN_REPLICAS=2
MAX_REPLICAS=10
SCALE_UP_COOLDOWN=300
SCALE_DOWN_COOLDOWN=600

# Security Headers
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: https:;"

# A/B Testing Configuration
AB_TESTING_ENABLED=true
AB_TESTING_DEFAULT_SPLIT=50
AB_TESTING_MIN_SAMPLE_SIZE=100

# Voice and Audio Configuration
TTS_PROVIDER=kokoro
TTS_QUALITY=high
SPATIAL_AUDIO_ENABLED=true
AUDIO_SAMPLE_RATE=22050
AUDIO_BITRATE=128

# Character and World Limits
MAX_CHARACTERS_PER_USER=50
MAX_WORLDS_PER_USER=10
MAX_CONVERSATIONS_PER_CHARACTER=1000
CHARACTER_MEMORY_SIZE=1000

# Training Configuration
TRAINING_QUEUE_SIZE=100
MAX_TRAINING_TIME=3600
TRAINING_BATCH_SIZE=16
TRAINING_LEARNING_RATE=1e-4
TRAINING_EPOCHS=3

# API Rate Limiting
API_RATE_LIMIT_PER_MINUTE=1000
WEBSOCKET_RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=30
TRAINING_RATE_LIMIT_PER_HOUR=5

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60

# Logging Configuration
LOG_FORMAT=json
LOG_ROTATION=true
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10

# Development and Testing (for staging environment)
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILING=false
MOCK_EXTERNAL_SERVICES=false 